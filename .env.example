# ==========================================
# Axora — Environment Configuration Example
# ==========================================

# API Configuration
PROJECT_NAME=Axora
API_V1_PREFIX=/api/v1
API_PORT=8000

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=axora
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/axora

# External LLM Provider Selection
# Options: nvidia (Free Tokens), openai, anthropic, ollama, mock
LLM_PROVIDER=nvidia

# NVIDIA NIM Configuration (Free API Tokens at build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-free-nvidia-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# OpenAI Configuration
LLM_API_KEY=sk-proj-your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Agent Execution Loop
MAX_AGENT_ITERATIONS=8
