# ==========================================
# Axora - Environment Configuration Example
# ==========================================

# API Configuration
PROJECT_NAME=Axora
API_V1_PREFIX=/api/v1
API_PORT=8000

# PostgreSQL (set a locally generated URL-safe password before starting Compose)
POSTGRES_USER=axora
POSTGRES_PASSWORD=
POSTGRES_DB=axora
POSTGRES_PORT=5432
# Compose overrides DATABASE_URL for the API. Set it for a local non-Docker setup.
DATABASE_URL=

# External LLM Provider Selection
# Options: groq, nvidia, gemini, openai, anthropic, ollama, mock
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Google Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-1.5-flash

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Ollama (Local LLM via Ollama)
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3:latest

# Optional services (set credentials before enabling their Compose profiles)
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=axora
MYSQL_USER=axora
MYSQL_PASSWORD=

# Agent Execution Loop
MAX_AGENT_ITERATIONS=8
